{
  "_comment": "Cross-machine signature library. Add entries here, never edit the scripts. pathTemplate tokens: %LOCALAPPDATA% %APPDATA% %USERPROFILE% %TEMP% %PROGRAMDATA% %SYSTEMDRIVE%",
  "version": 1,
  "patterns": [
    { "id": "user-temp",        "pathTemplate": "%TEMP%",                          "category": "junk",      "owner": "",            "note": "per-user temp; age-filter mandatory" },
    { "id": "win-temp",         "pathTemplate": "%SYSTEMDRIVE%\\Windows\\Temp",     "category": "junk",      "owner": "",            "note": "system temp" },
    { "id": "wu-download",      "pathTemplate": "%SYSTEMDRIVE%\\Windows\\SoftwareDistribution\\Download", "category": "junk", "owner": "wuauserv", "note": "already-applied update payloads" },
    { "id": "crash-dumps",      "pathTemplate": "%LOCALAPPDATA%\\CrashDumps",       "category": "evidence",  "owner": "",            "note": "crash dumps; keep unless user says otherwise" },
    { "id": "npm-cache",        "pathTemplate": "%LOCALAPPDATA%\\npm-cache",        "category": "rebuildable", "owner": "node",       "note": "may contain _npx packages that are EXECUTING - check in-use" },
    { "id": "node-corepack",    "pathTemplate": "%LOCALAPPDATA%\\node-corepack",    "category": "rebuildable", "owner": "node",       "note": "" },
    { "id": "pip-cache",        "pathTemplate": "%LOCALAPPDATA%\\pip\\cache",       "category": "rebuildable", "owner": "python",     "note": "" },
    { "id": "uv-cache",         "pathTemplate": "%LOCALAPPDATA%\\uv",               "category": "rebuildable", "owner": "python",     "note": "uv may hardlink cache into venvs; cross-drive move forces copies" },
    { "id": "pub-cache",        "pathTemplate": "%LOCALAPPDATA%\\Pub\\Cache",       "category": "rebuildable", "owner": "dart",       "note": "Flutter/Dart packages" },
    { "id": "gradle-home",      "pathTemplate": "%USERPROFILE%\\.gradle",           "category": "rebuildable", "owner": "java",       "note": "wrapper+ caches; big re-download cost for Android builds" },
    { "id": "nuget-packages",   "pathTemplate": "%USERPROFILE%\\.nuget\\packages",  "category": "rebuildable", "owner": "dotnet",     "note": "" },
    { "id": "cargo-registry",   "pathTemplate": "%USERPROFILE%\\.cargo\\registry",  "category": "rebuildable", "owner": "",           "note": "" },
    { "id": "gopath-pkg",       "pathTemplate": "%USERPROFILE%\\go\\pkg\\mod",      "category": "rebuildable", "owner": "",           "note": "" },
    { "id": "android-avd",      "pathTemplate": "%USERPROFILE%\\.android\\avd",     "category": "userdata",  "owner": "",            "note": "emulator disk images, can be many GB" },
    { "id": "android-sdk",      "pathTemplate": "%LOCALAPPDATA%\\Android\\Sdk",     "category": "rebuildable", "owner": "",           "note": "sdkmanager can reinstall, but slow" },
    { "id": "wsl-distro",       "pathTemplate": "%LOCALAPPDATA%\\wsl",              "category": "userdata",  "owner": "",            "note": "ext4.vhdx - real user data, back up before touching" },
    { "id": "docker-desktop",   "pathTemplate": "%APPDATA%\\Docker Desktop",        "category": "userdata",  "owner": "Docker Desktop", "note": "wsl-data distro vhdx" },
    { "id": "edge-cache",       "pathTemplate": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache", "category": "junk", "owner": "msedge", "note": "cache only, never the Profile dir" },
    { "id": "chrome-cache",     "pathTemplate": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Cache",  "category": "junk", "owner": "chrome", "note": "cache only" },
    { "id": "d3d-shader-cache", "pathTemplate": "%LOCALAPPDATA%\\D3DSCache",        "category": "junk",      "owner": "",            "note": "shader cache, rebuilds" },
    { "id": "thumbnail-cache",  "pathTemplate": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer", "category": "junk", "owner": "",     "note": "thumbcache_*.db only, not the whole dir" },
    { "id": "electron-updaters", "pathTemplate": "%LOCALAPPDATA%\\*-updater",       "category": "junk",      "owner": "",            "note": "old installer packages kept by Electron/Squirrel updaters; glob" },
    { "id": "wechat-files",     "pathTemplate": "%USERPROFILE%\\Documents\\WeChat Files",        "category": "userdata", "owner": "WeChat", "note": "chat history - never auto-delete" },
    { "id": "wxwork-files",     "pathTemplate": "%USERPROFILE%\\Documents\\WXWork",              "category": "userdata", "owner": "",     "note": "" },
    { "id": "qq-files",         "pathTemplate": "%USERPROFILE%\\Documents\\Tencent Files",       "category": "userdata", "owner": "",     "note": "" },
    { "id": "xwechat-files",    "pathTemplate": "%USERPROFILE%\\Documents\\xwechat_files",       "category": "userdata", "owner": "",     "note": "" },
    { "id": "wps-kingsoft",     "pathTemplate": "%APPDATA%\\kingsoft",              "category": "mixed",     "owner": "wps",          "note": "config + cloud cache + doc index, needs drill-down" },
    { "id": "onedrive",         "pathTemplate": "%USERPROFILE%\\OneDrive",          "category": "userdata",  "owner": "OneDrive",     "note": "check whether files are online-only placeholders first" },
    { "id": "downloads",        "pathTemplate": "%USERPROFILE%\\Downloads",         "category": "userdata",  "owner": "",            "note": "user files; only report, never delete" },
    { "id": "desktop",          "pathTemplate": "%USERPROFILE%\\Desktop",           "category": "userdata",  "owner": "",            "note": "user files" },
    { "id": "documents",        "pathTemplate": "%USERPROFILE%\\Documents",         "category": "userdata",  "owner": "",            "note": "user files" },
    { "id": "local-programs",   "pathTemplate": "%LOCALAPPDATA%\\Programs",         "category": "app-binary", "owner": "",           "note": "per-user app installs; relocate by uninstall+reinstall, not by moving" },
    { "id": "recycle-bin",      "pathTemplate": "%SYSTEMDRIVE%\\$Recycle.Bin",      "category": "user-deleted", "owner": "",        "note": "user deliberately deleted these; needs explicit confirmation" }
  ],

  "_category_meaning": {
    "junk": "safe to delete once age-filtered",
    "rebuildable": "safe to delete, but costs re-download; usually better to relocate to another drive",
    "evidence": "logs/dumps that may be needed for diagnosis; archive rather than delete",
    "userdata": "do not delete; relocate only with explicit approval and only copy-verify-keep",
    "mixed": "contains both cache and user data - drill down before deciding",
    "app-binary": "installed program files - do NOT move by hand, use uninstaller",
    "user-deleted": "already in a recycle bin"
  }
}
